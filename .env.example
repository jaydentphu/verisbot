# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# ---------------------------------------------------------------------------

# From @BotFather on Telegram: /newbot, then copy the token it gives you.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Optional. Restricts the bot to a single group so it ignores every other chat.
# To find it: add the bot to the group, post a message, then open
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates and read chat.id
# (group IDs are negative). Leave blank to allow every chat.
TELEGRAM_GROUP_ID=-1001234567890

# From https://www.notion.so/my-integrations — create an internal integration
# and copy its secret.
NOTION_INTEGRATION_TOKEN=ntn_ExampleIntegrationTokenReplaceMe

# The 32-character ID in your database URL. The database must be shared with
# the integration above, and needs a `Name` title property. `Created time`
# (Date) and `Person` (Text) are optional but recommended.
NOTION_DATABASE_ID=00000000000000000000000000000000
